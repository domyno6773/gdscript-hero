# GDScript Hero Arena — Oracle Ampere A1 (ARM64) image.
# THIS FILE ONLY BUILDS LOCALLY. It never creates cloud resources or changes a subscription.
# Production image must be audited before exposing untrusted code; do not install
# Godot or Docker on a paid Compute instance.
FROM --platform=linux/arm64 debian:bookworm-slim AS download
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates coreutils \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    base="https://github.com/godotengine/godot-builds/releases/download/4.4.1-stable"; \
    asset="Godot_v4.4.1-stable_linux.arm64.zip"; \
    curl --fail --location --retry 4 --silent --show-error "$base/$asset" -o "/tmp/$asset"; \
    curl --fail --location --retry 4 --silent --show-error "$base/SHA512-SUMS.txt" -o /tmp/SHA512-SUMS.txt; \
    cd /tmp; \
    grep " $asset\$" SHA512-SUMS.txt > asset.sha512; \
    test "$(wc -l < asset.sha512)" -eq 1; \
    sha512sum --check --status asset.sha512; \
    unzip -q "$asset"; \
    mv Godot_v4.4.1-stable_linux.arm64 /tmp/godot; \
    chmod 555 /tmp/godot

FROM --platform=linux/arm64 debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libgcc-s1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/gdh /work
COPY --from=download /tmp/godot /usr/local/bin/godot
COPY project.godot grader.gd /opt/gdh/
USER 65534:65534
ENV HOME=/tmp
WORKDIR /opt/gdh
ENTRYPOINT ["/usr/local/bin/godot","--headless","--path","/opt/gdh","--script","res://grader.gd","--"]
